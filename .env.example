# =============================================================================
# 환경변수 목록 — 복사해서 .env 로 쓰고 값만 바꿈 (.env 는 커밋 금지, .gitignore 대상)
#   로컬:   set -a; source .env; set +a
#   GitHub: Settings → Secrets and variables → Actions → Variables 에 같은 이름으로 (TF_VAR_* 줄은 제외)
# 비밀값(액세스 키·비밀번호·토큰)은 여기에 적지 않음 — AWS 자격 증명은 aws configure / OIDC
# =============================================================================

# ---------- 공통 (필수) ----------
AWS_REGION=ap-northeast-2                 # AWS 리전
PROJECT=baedalsak                         # 프로젝트 이름 — 리소스 이름 <PROJECT>-<ENV_NAME>
ENV_NAME=prod                             # 환경 이름 — 앱 K8s namespace·MQ vhost(/<ENV_NAME>) 로도 사용
AZS='["ap-northeast-2a","ap-northeast-2c"]'  # 사용할 AZ 2개 (JSON 배열)
KUBERNETES_VERSION=1.35                   # EKS 버전
DOMAIN_NAME=baedalsak.click               # Route 53 에서 구매한 도메인 (CloudFront · ACM · SES · Cognito 메일)
GITHUB_REF_DEFAULT=develop                # 예약 켜기·끄기가 실행할 브랜치 (로컬 terraform 용, Actions 는 기본 브랜치 자동)

# ---------- bootstrap 입력 (필수) ----------
GITHUB_REPO=SeSac-4/baedalsak-infra                 # OIDC 신뢰 대상 레포 (워크플로가 있는 이 레포, owner/repo)
TF_STATE_BUCKET=baedalsak-prod-tfstate-123456789012   # 만들 state 버킷 (전역 고유, 계정 ID 를 붙이는 것을 권장)

# ---------- bootstrap 출력 → GitHub Variables (로컬 실행에는 불필요) ----------
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/baedalsak-prod-github-actions  # terraform output github_actions_role_arn

# ---------- 앱 이미지 (GitHub Actions "앱 이미지 빌드" 워크플로) ----------
SERVER_REPO=SeSac-4/baedalsak-server      # 빌드할 서버 레포 (owner/repo). private 이면 레포 Secret SERVER_REPO_TOKEN 추가
SERVER_REF=develop                        # 기본 브랜치·태그 (실행 시 입력 server_ref 가 우선)
CLIENT_REPO=SeSac-4/baedalsak-client      # 프론트 레포 (프론트 배포 워크플로)
CLIENT_REF=develop                        # 프론트 기본 브랜치

# ---------- 선택 (비우면 <PROJECT>·<ENV_NAME> 규칙으로 자동) ----------
CLUSTER_NAME=                             # EKS 클러스터 이름 (기본 <PROJECT>-<ENV_NAME>)
SECRET_PREFIX=                            # Secrets Manager 접두사 (기본 <PROJECT>/<ENV_NAME>)
SSM_PREFIX=                               # SSM 파라미터 경로 (기본 /<PROJECT>/<ENV_NAME>, / 로 시작)
LOG_GROUP=                                # 컨테이너 로그 그룹 (기본 /<PROJECT>/<ENV_NAME>/containers)
TEAM_MEMBER_ARNS='[]'                     # EKS 접근 팀원 ARN JSON 배열, 예: '["arn:aws:iam::123456789012:user/name"]'
BUDGET_DAILY_USD=10                       # 일일 예산 USD — 넘으면 끄기 실행 (Budgets → Lambda ③)
BUDGET_WARN_USD=5                         # 일일 비용 경고 USD — 넘으면 메일만
ALERT_EMAILS='["<메일>@example.com"]'  # 알림 메일 JSON 배열 (알람·켜기/끄기 결과·예산) — 구독 확인 메일 1회 클릭

# ---------- Terraform 전달 (수정 금지 — 위 값을 TF_VAR_* 로 넘김, 로컬 전용) ----------
TF_VAR_region=${AWS_REGION}
TF_VAR_project=${PROJECT}
TF_VAR_env=${ENV_NAME}
TF_VAR_azs=${AZS}
TF_VAR_kubernetes_version=${KUBERNETES_VERSION}
TF_VAR_github_repo=${GITHUB_REPO}
TF_VAR_state_bucket=${TF_STATE_BUCKET}
TF_VAR_cluster_name=${CLUSTER_NAME}
TF_VAR_secret_prefix=${SECRET_PREFIX}
TF_VAR_ssm_prefix=${SSM_PREFIX}
TF_VAR_log_group_name=${LOG_GROUP}
TF_VAR_team_member_arns=${TEAM_MEMBER_ARNS}
TF_VAR_domain_name=${DOMAIN_NAME}
TF_VAR_budget_daily_usd=${BUDGET_DAILY_USD}
TF_VAR_budget_warn_usd=${BUDGET_WARN_USD}
TF_VAR_alert_emails=${ALERT_EMAILS}
TF_VAR_github_ref=${GITHUB_REF_DEFAULT}
